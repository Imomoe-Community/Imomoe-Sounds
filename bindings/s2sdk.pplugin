{
  "$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
  "version": "3.4.3",
  "name": "s2sdk",
  "description": "Provides functionality for other plugins from Source 2 engine",
  "author": "untrustedmodders",
  "website": "https://github.com/untrustedmodders/",
  "license": "GPLv3",
  "entry": "bin/plugify-plugin-s2sdk",
  "platforms": [],
  "language": "cpp",
  "methods": [
    {
      "name": "GetCurrentMap",
      "group": "Engine",
      "description": "Returns the current map name.",
      "funcName": "GetCurrentMap",
      "paramTypes": [],
      "retType": {
        "type": "string",
        "description": "A reference to a string where the current map name will be stored."
      }
    },
    {
      "name": "GetGameDirectory",
      "group": "Engine",
      "description": "Returns the path of the game's directory.",
      "funcName": "GetGameDirectory",
      "paramTypes": [],
      "retType": {
        "type": "string",
        "description": "A reference to a string where the game directory path will be stored."
      }
    },
    {
      "name": "ServerCommandEx",
      "group": "Commands",
      "description": "Executes a server command right away as if it were on the server console (or RCON) and returns the printed text. Console commands and convars only: commands are split on ';' and new lines, aliases are not expanded.",
      "funcName": "ServerCommandEx",
      "paramTypes": [
        {
          "name": "command",
          "type": "string",
          "ref": false,
          "description": "The command to execute on the server."
        }
      ],
      "retType": {
        "type": "string",
        "description": "String to store command result into."
      }
    },
    {
      "name": "GetServerAddons",
      "group": "Addons",
      "description": "Retrieves the workshop addons that are mounted on the server and sent to all clients.",
      "funcName": "GetServerAddons",
      "paramTypes": [],
      "retType": {
        "type": "uint64[]",
        "description": "An array of workshop IDs from s2_extra_addons."
      }
    },
    {
      "name": "GetClientSteamID64",
      "group": "Clients",
      "description": "Returns the client's SteamID64 - a unique 64-bit identifier of a Steam account.",
      "funcName": "GetClientSteamID64",
      "paramTypes": [
        {
          "name": "playerSlot",
          "type": "int32",
          "ref": false,
          "description": "The index of the player's slot."
        }
      ],
      "retType": {
        "type": "uint64",
        "description": "uint64_t The client's SteamID64."
      }
    },
    {
      "name": "GetClientLanguageCode",
      "group": "Clients",
      "description": "Retrieves a client's language as an ISO code. Unlike GetClientLanguage, which returns the raw cl_language value (\"english\", \"schinese\"), this returns the code translation files are keyed by (\"en\", \"zh-CN\"). Empty until the client answers the cl_language query, and always empty for bots. Reliably available starting from OnClientAuthenticated and OnClientPutInServer.",
      "funcName": "GetClientLanguageCode",
      "paramTypes": [
        {
          "name": "playerSlot",
          "type": "int32",
          "ref": false,
          "description": "The index of the player's slot."
        }
      ],
      "retType": {
        "type": "string",
        "description": "The client's ISO language code."
      }
    },
    {
      "name": "IsClientInGame",
      "group": "Clients",
      "description": "Checks if a certain player has entered the game.",
      "funcName": "IsClientInGame",
      "paramTypes": [
        {
          "name": "playerSlot",
          "type": "int32",
          "ref": false,
          "description": "The index of the player's slot."
        }
      ],
      "retType": {
        "type": "bool",
        "description": "true if the player is in the game, false otherwise."
      }
    },
    {
      "name": "IsFakeClient",
      "group": "Clients",
      "description": "Checks if a certain player is a fake client.",
      "funcName": "IsFakeClient",
      "paramTypes": [
        {
          "name": "playerSlot",
          "type": "int32",
          "ref": false,
          "description": "The index of the player's slot."
        }
      ],
      "retType": {
        "type": "bool",
        "description": "true if the client is a fake client, false otherwise."
      }
    },
    {
      "name": "GetClientTeam",
      "group": "Clients",
      "description": "Retrieves the team number of an client.",
      "funcName": "GetClientTeam",
      "paramTypes": [
        {
          "name": "playerSlot",
          "type": "int32",
          "ref": false,
          "description": "The index of the player's slot whose team number is to be retrieved."
        }
      ],
      "retType": {
        "type": "int32",
        "description": "The team number of the client, or 0 if the client is invalid.",
        "enum": "CSTeam"
      }
    },
    {
      "name": "GetClientAbsOrigin",
      "group": "Clients",
      "description": "Retrieves the absolute origin of an client.",
      "funcName": "GetClientAbsOrigin",
      "paramTypes": [
        {
          "name": "playerSlot",
          "type": "int32",
          "ref": false,
          "description": "The index of the player's slot whose absolute origin is to be retrieved."
        }
      ],
      "retType": {
        "type": "vec3",
        "description": "A vector where the absolute origin will be stored."
      }
    },
    {
      "name": "IsClientAlive",
      "group": "Clients",
      "description": "Checks if a certain player is alive.",
      "funcName": "IsClientAlive",
      "paramTypes": [
        {
          "name": "playerSlot",
          "type": "int32",
          "ref": false,
          "description": "The index of the player's slot."
        }
      ],
      "retType": {
        "type": "bool",
        "description": "True if the client is alive, false otherwise."
      }
    },
    {
      "name": "GetGameRules",
      "group": "Gamerules",
      "description": "Retrieves the pointer to the current game rules instance.",
      "funcName": "GetGameRules",
      "paramTypes": [],
      "retType": {
        "type": "ptr64",
        "description": "A pointer to the game rules object."
      }
    },
    {
      "name": "GetSchemaOffset",
      "group": "Schema",
      "description": "Gets the offset of a member in a schema class.",
      "funcName": "GetSchemaOffset",
      "paramTypes": [
        {"name": "className", "type": "string", "ref": false, "description": "The schema class name."},
        {"name": "memberName", "type": "string", "ref": false, "description": "The schema member name."}
      ],
      "retType": {"type": "int32", "description": "The field offset, or -1 if unavailable."}
    },
    {
      "name": "GetEntSchema2",
      "group": "Schema",
      "description": "Retrieves an integer value from an entity's schema.",
      "funcName": "GetEntSchema2",
      "paramTypes": [
        {"name": "entity", "type": "ptr64", "ref": false, "description": "Entity pointer."},
        {"name": "className", "type": "string", "ref": false, "description": "The schema class name."},
        {"name": "memberName", "type": "string", "ref": false, "description": "The schema member name."},
        {"name": "element", "type": "int32", "ref": false, "description": "Array element index."}
      ],
      "retType": {
        "type": "int64",
        "description": "The schema value."
      }
    },
    {
      "name": "OnGameFrame_Register",
      "group": "Listeners",
      "description": "Register a callback before each server frame.",
      "funcName": "OnGameFrame_Register",
      "paramTypes": [
        {"name": "callback", "type": "function", "ref": false, "description": "Frame callback.", "prototype": "OnGameFrameCallback"}
      ],
      "retType": {"type": "void"}
    },
    {
      "name": "OnGameFrame_Unregister",
      "group": "Listeners",
      "description": "Unregister a callback from server frames.",
      "funcName": "OnGameFrame_Unregister",
      "paramTypes": [
        {"name": "callback", "type": "function", "ref": false, "description": "Frame callback.", "prototype": "OnGameFrameCallback"}
      ],
      "retType": {"type": "void"}
    },
    {
      "name": "GetClientPawn",
      "group": "Clients",
      "description": "Retrieves the pawn entity pointer associated with a client.",
      "funcName": "GetClientPawn",
      "paramTypes": [
        {
          "name": "playerSlot",
          "type": "int32",
          "ref": false,
          "description": "The index of the player's slot."
        }
      ],
      "retType": {
        "type": "ptr64",
        "description": "A pointer to the client's pawn entity, or nullptr if the client or controller is invalid."
      }
    },
    {
      "name": "AddConsoleCommand",
      "group": "Commands",
      "description": "Creates a console command or hooks an already existing one.",
      "funcName": "AddConsoleCommand",
      "paramTypes": [
        {
          "name": "name",
          "type": "string",
          "ref": false,
          "description": "The name of the console command."
        },
        {
          "name": "description",
          "type": "string",
          "ref": false,
          "description": "A brief description of what the command does."
        },
        {
          "name": "flags",
          "type": "int64",
          "ref": false,
          "description": "Command flags that define the behavior of the command.",
          "enum": "ConVarFlag"
        },
        {
          "name": "callback",
          "type": "function",
          "ref": false,
          "description": "A callback function that is invoked when the command is executed.",
          "prototype": "ConCommandCallback"
        },
        {
          "type": "uint8",
          "name": "type",
          "description": "Whether the hook was in post mode (after processing) or pre mode (before processing).",
          "enum": "HookMode"
        }
      ],
      "retType": {
        "type": "bool",
        "description": "true if the command was successfully created; otherwise, false."
      }
    },
    {
      "name": "RemoveCommand",
      "group": "Commands",
      "description": "Removes a console command from the system.",
      "funcName": "RemoveCommand",
      "paramTypes": [
        {
          "name": "name",
          "type": "string",
          "ref": false,
          "description": "The name of the command to be removed."
        },
        {
          "name": "callback",
          "type": "function",
          "ref": false,
          "description": "The callback function associated with the command to be removed.",
          "prototype": "ConCommandCallback"
        }
      ],
      "retType": {
        "type": "bool",
        "description": "true if the command was successfully removed; otherwise, false."
      }
    },
    {
      "name": "ReplyToCommand",
      "group": "Console",
      "description": "Sends a reply message to a player or to the server console depending on the command context.",
      "funcName": "ReplyToCommand",
      "paramTypes": [
        {
          "name": "context",
          "type": "int32",
          "ref": false,
          "description": "The context from which the command was called (e.g., Console or Chat).",
          "enum": "ConCommandContext"
        },
        {
          "name": "playerSlot",
          "type": "int32",
          "ref": false,
          "description": "The slot/index of the player receiving the message."
        },
        {
          "name": "message",
          "type": "string",
          "ref": false,
          "description": "The message string to be sent as a reply."
        }
      ],
      "retType": {
        "type": "void"
      }
    },
    {
      "name": "FindConVar",
      "group": "Cvars",
      "description": "Searches for a console variable.",
      "funcName": "FindConVar",
      "paramTypes": [
        {
          "name": "name",
          "type": "string",
          "ref": false,
          "description": "The name of the console variable to search for."
        }
      ],
      "retType": {
        "type": "uint64",
        "description": "A handle to the console variable data if found; otherwise, nullptr."
      }
    },
    {
      "name": "GetConVarBool",
      "group": "Cvars",
      "description": "Retrieves the current value of a boolean console variable.",
      "funcName": "GetConVarBool",
      "paramTypes": [
        {
          "name": "conVarHandle",
          "type": "uint64",
          "ref": false,
          "description": "The handle to the console variable data."
        }
      ],
      "retType": {
        "type": "bool",
        "description": "The current boolean value of the console variable."
      }
    },
    {
      "name": "ReadFileVPK",
      "group": "Filesystem",
      "description": "Reads a file and returns its contents as a string.",
      "funcName": "ReadFileVPK",
      "paramTypes": [
        {
          "name": "localFileName",
          "type": "string",
          "ref": false,
          "description": "The relative path of the file to read."
        },
        {
          "name": "pathId",
          "type": "string",
          "ref": false,
          "description": "The filesystem search path ID (e.g., \"GAME\"). If empty, uses \"GAME\"."
        }
      ],
      "retType": {
        "type": "string",
        "description": "The file contents, or an empty string on failure."
      }
    },
    {
      "name": "GetGameTickCount",
      "group": "Engine",
      "description": "Returns the game's internal tick count.",
      "funcName": "GetGameTickCount",
      "paramTypes": [],
      "retType": {
        "type": "int32",
        "description": "The current tick count of the game."
      }
    },
    {
      "name": "GetMaxClients",
      "group": "Engine",
      "description": "Returns the maximum number of clients that can connect to the server.",
      "funcName": "GetMaxClients",
      "paramTypes": [],
      "retType": {
        "type": "int32",
        "description": "The maximum client count, or -1 if global variables are not initialized."
      }
    },
    {
      "name": "Precache",
      "group": "Engine",
      "description": "Precaches a given file.",
      "funcName": "Precache",
      "paramTypes": [
        {
          "name": "resource",
          "type": "string",
          "ref": false,
          "description": "The name of the resource to be precached."
        }
      ],
      "retType": {
        "type": "void"
      }
    },
    {
      "name": "StopSound",
      "group": "Engine",
      "description": "Stops a sound from a specified entity.",
      "funcName": "StopSound",
      "paramTypes": [
        {
          "name": "entityHandle",
          "type": "int32",
          "ref": false,
          "description": "The handle of the entity that will stop the sound."
        },
        {
          "name": "sound",
          "type": "string",
          "ref": false,
          "description": "The name of the sound to stop."
        }
      ],
      "retType": {
        "type": "void"
      }
    },
    {
      "name": "EmitSoundToClient",
      "group": "Engine",
      "description": "Emits a sound to one or more clients.",
      "funcName": "EmitSoundToClient",
      "paramTypes": [
        {
          "name": "entityHandle",
          "type": "int32",
          "ref": false,
          "description": "The handle of the entity that emits the sound."
        },
        {
          "name": "playersSlot",
          "type": "int32[]",
          "ref": false,
          "description": "Player slot indices that will hear the sound."
        },
        {
          "name": "sound",
          "type": "string",
          "ref": false,
          "description": "The name of the sound to emit."
        },
        {
          "name": "volume",
          "type": "float",
          "ref": false,
          "description": "The volume of the sound."
        },
        {
          "name": "pitch",
          "type": "float",
          "ref": false,
          "description": "The pitch of the sound."
        }
      ],
      "retType": {
        "type": "void"
      }
    },
    {
      "name": "EntHandleToEntPointer",
      "group": "Entities",
      "description": "Retrieves the entity pointer from an entity handle.",
      "funcName": "EntHandleToEntPointer",
      "paramTypes": [
        {"name": "entityHandle", "type": "int32", "ref": false, "description": "The entity handle."}
      ],
      "retType": {
        "type": "ptr64",
        "description": "The entity pointer or nullptr if the handle is invalid."
      }
    },
    {
      "name": "EntIndexToEntHandle",
      "group": "Entities",
      "description": "Converts an entity index into an entity handle.",
      "funcName": "EntIndexToEntHandle",
      "paramTypes": [
        {
          "name": "entityIndex",
          "type": "int32",
          "ref": false,
          "description": "The index of the entity to convert."
        }
      ],
      "retType": {
        "type": "int32",
        "description": "The entity handle as an integer, or -1 if the entity index is invalid."
      }
    },
    {
      "name": "IsValidEntHandle",
      "group": "Entities",
      "description": "Checks if the provided entity handle is valid.",
      "funcName": "IsValidEntHandle",
      "paramTypes": [
        {
          "name": "entityHandle",
          "type": "int32",
          "ref": false,
          "description": "The entity handle to check."
        }
      ],
      "retType": {
        "type": "bool",
        "description": "True if the entity handle is valid, false otherwise."
      }
    },
    {
      "name": "GetEntityAbsOrigin",
      "group": "Entities",
      "description": "Retrieves the absolute origin of an entity.",
      "funcName": "GetEntityAbsOrigin",
      "paramTypes": [
        {
          "name": "entityHandle",
          "type": "int32",
          "ref": false,
          "description": "The handle of the entity whose absolute origin is to be retrieved."
        }
      ],
      "retType": {
        "type": "vec3",
        "description": "A vector where the absolute origin will be stored."
      }
    },
    {
      "name": "HookEvent",
      "group": "Events",
      "description": "Creates a hook for when a game event is fired.",
      "funcName": "HookEvent",
      "paramTypes": [
        {
          "name": "name",
          "type": "string",
          "ref": false,
          "description": "The name of the event to hook."
        },
        {
          "name": "callback",
          "type": "function",
          "ref": false,
          "description": "The callback function to call when the event is fired.",
          "prototype": "EventCallback"
        },
        {
          "type": "uint8",
          "name": "type",
          "description": "Whether the hook was in post mode (after processing) or pre mode (before processing).",
          "enum": "HookMode"
        }
      ],
      "retType": {
        "type": "int32",
        "description": "An integer indicating the result of the hook operation.",
        "enum": "EventHookError"
      }
    },
    {
      "name": "UnhookEvent",
      "group": "Events",
      "description": "Removes a hook for when a game event is fired.",
      "funcName": "UnhookEvent",
      "paramTypes": [
        {
          "name": "name",
          "type": "string",
          "ref": false,
          "description": "The name of the event to unhook."
        },
        {
          "name": "callback",
          "type": "function",
          "ref": false,
          "description": "The callback function to remove.",
          "prototype": "EventCallback"
        },
        {
          "type": "uint8",
          "name": "type",
          "description": "Whether the hook was in post mode (after processing) or pre mode (before processing).",
          "enum": "HookMode"
        }
      ],
      "retType": {
        "type": "int32",
        "description": "An integer indicating the result of the unhook operation.",
        "enum": "EventHookError"
      }
    },
    {
      "name": "GetEventBool",
      "group": "Events",
      "description": "Retrieves the boolean value of a game event's key.",
      "funcName": "GetEventBool",
      "paramTypes": [
        {
          "name": "event",
          "type": "ptr64",
          "ref": false,
          "description": "A pointer to the IGameEvent object containing event data."
        },
        {
          "name": "key",
          "type": "string",
          "ref": false,
          "description": "The key for which to retrieve the boolean value."
        }
      ],
      "retType": {
        "type": "bool",
        "description": "The boolean value associated with the key."
      }
    },
    {
      "name": "GetEventString",
      "group": "Events",
      "description": "Retrieves the string value of a game event's key.",
      "funcName": "GetEventString",
      "paramTypes": [
        {
          "name": "event",
          "type": "ptr64",
          "ref": false,
          "description": "A pointer to the IGameEvent object containing event data."
        },
        {
          "name": "key",
          "type": "string",
          "ref": false,
          "description": "The key for which to retrieve the string value."
        }
      ],
      "retType": {
        "type": "string",
        "description": "A string where the result will be stored."
      }
    },
    {
      "name": "GetEventInt",
      "group": "Events",
      "description": "Retrieves the integer value of a game event's key.",
      "funcName": "GetEventInt",
      "paramTypes": [
        {
          "name": "event",
          "type": "ptr64",
          "ref": false,
          "description": "A pointer to the IGameEvent object containing event data."
        },
        {
          "name": "key",
          "type": "string",
          "ref": false,
          "description": "The key for which to retrieve the integer value."
        }
      ],
      "retType": {
        "type": "int32",
        "description": "The integer value associated with the key."
      }
    },
    {
      "name": "GetEventPlayerSlot",
      "group": "Events",
      "description": "Retrieves the player slot of a game event's key.",
      "funcName": "GetEventPlayerSlot",
      "paramTypes": [
        {
          "name": "event",
          "type": "ptr64",
          "ref": false,
          "description": "A pointer to the IGameEvent object containing event data."
        },
        {
          "name": "key",
          "type": "string",
          "ref": false,
          "description": "The key for which to retrieve the player index."
        }
      ],
      "retType": {
        "type": "int32",
        "description": "The player slot associated with the key."
      }
    },
    {
      "name": "OnBuildGameSessionManifest_Register",
      "group": "Listeners",
      "description": "Register callback to event.",
      "funcName": "OnBuildGameSessionManifest_Register",
      "paramTypes": [
        {
          "name": "callback",
          "type": "function",
          "ref": false,
          "description": "Function callback.",
          "prototype": "OnBuildGameSessionManifestCallback"
        }
      ],
      "retType": {
        "type": "void"
      }
    },
    {
      "name": "OnBuildGameSessionManifest_Unregister",
      "group": "Listeners",
      "description": "Unregister callback to event.",
      "funcName": "OnBuildGameSessionManifest_Unregister",
      "paramTypes": [
        {
          "name": "callback",
          "type": "function",
          "ref": false,
          "description": "Function callback.",
          "prototype": "OnBuildGameSessionManifestCallback"
        }
      ],
      "retType": {
        "type": "void"
      }
    },
    {
      "name": "OnMapStart_Register",
      "group": "Listeners",
      "description": "Register callback to event.",
      "funcName": "OnMapStart_Register",
      "paramTypes": [
        {
          "name": "callback",
          "type": "function",
          "ref": false,
          "description": "Function callback.",
          "prototype": "OnMapStartCallback"
        }
      ],
      "retType": {
        "type": "void"
      }
    },
    {
      "name": "OnMapStart_Unregister",
      "group": "Listeners",
      "description": "Unregister callback to event.",
      "funcName": "OnMapStart_Unregister",
      "paramTypes": [
        {
          "name": "callback",
          "type": "function",
          "ref": false,
          "description": "Function callback.",
          "prototype": "OnMapStartCallback"
        }
      ],
      "retType": {
        "type": "void"
      }
    },
    {
      "name": "OnMapEnd_Register",
      "group": "Listeners",
      "description": "Register callback to event.",
      "funcName": "OnMapEnd_Register",
      "paramTypes": [
        {
          "name": "callback",
          "type": "function",
          "ref": false,
          "description": "Function callback.",
          "prototype": "OnMapEndCallback"
        }
      ],
      "retType": {
        "type": "void"
      }
    },
    {
      "name": "OnMapEnd_Unregister",
      "group": "Listeners",
      "description": "Unregister callback to event.",
      "funcName": "OnMapEnd_Unregister",
      "paramTypes": [
        {
          "name": "callback",
          "type": "function",
          "ref": false,
          "description": "Function callback.",
          "prototype": "OnMapEndCallback"
        }
      ],
      "retType": {
        "type": "void"
      }
